# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIFFS_PAGE_SIZE=512
# LVGL draw-buffer height. The BSP fork puts the draw BUFFER in PSRAM
# (buff_dma+buff_spiram), but the SPI flush STILL needs an internal DMA bounce
# buffer of 410 x H x 2B (~13 KB at 16) per flush: esp_ptr_dma_capable() is false
# for PSRAM, so spi_master bounces the color data through internal RAM regardless.
# So H is capped by what fits a contiguous internal block: 16 works (~13 KB), 64
# does NOT (52 KB bounce → setup_dma_priv_buffer failures + corruption). Do not
# raise above 16 without first eliminating the bounce (PSRAM-source SPI DMA, or
# dropping the RGB565 byte-swap) — see AGENTS.md.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=16
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
# Internal RAM is the scarce resource on this board. Allocations below this
# threshold are forced into internal RAM; lowering it (default 16384) pushes
# larger general allocations to the near-empty PSRAM. 4096 is the balance: it
# offloads the cold medium allocations without pushing the tiny/hot ones (LVGL,
# SPIFFS work buffers) to slower PSRAM (2048 measurably slowed SPIFFS I/O). The
# stack right-sizing + PSRAM moves freed enough internal (~30 KB largest block)
# that the ~13 KB LCD bounce buffer no longer needs the extra headroom 2048 gave.
# DMA/ISR buffers request MALLOC_CAP_DMA/INTERNAL explicitly, so they stay internal.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Lower RTOS tick rate to reduce idle overhead (was 1000)
CONFIG_FREERTOS_HZ=200
# Timer task needs enough stack for settings_write_json (SPIFFS + cJSON).
# Right-sized from measured high-water (~2.1 KB peak) + margin via the Run Tests
# Stack/heap report; do NOT shrink without re-measuring.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4608
# uxTaskGetSystemState() for the Run Tests "Stack/heap report" diagnostic
# (per-task stack high-water marks). Tiny overhead.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_ENABLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
CONFIG_PM_RESTORE_CACHE_TAGMEM_AFTER_LIGHT_SLEEP=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# Enable power management and dynamic frequency scaling
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# Two SW draw worker tasks (swdraw); right-sized from measured high-water
# (~1.8 KB peak each) + generous margin. Internal stacks, x2.
CONFIG_LV_DRAW_THREAD_STACK_SIZE=5120
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_26=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_IMGFONT=y

CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_THEME_DEFAULT_GROW=y
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=80
CONFIG_LV_USE_THEME_SIMPLE=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y


#
# BT config — disabled; re-enable when adding ANCS support
#
CONFIG_BT_ENABLED=n

# WiFi
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Trim WiFi's oversized internal RAM footprint. This watch only does NTP + a
# low-rate SignalK WebSocket, so the high-throughput default buffer counts are
# wasted internal RAM. (Note: CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is left OFF
# on purpose — it forces WiFi TX into static buffers + 32 internal TX-cache
# buffers, which made internal RAM *worse*. The real fix for the LCD-flush
# starvation is the smaller LVGL buffer above.)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8

# Event loop task needs stack for bsp_display_lock + LVGL ops in event handlers.
# Right-sized from measured high-water (~3.6 KB peak) + margin; re-measure before
# shrinking further (handlers run arbitrary user code incl. NTP->RTC NVS).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
